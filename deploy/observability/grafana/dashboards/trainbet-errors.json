{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Provider failures",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum by (provider, status) (count_over_time({job=\"docker\", provider!=\"\"} | json | level=~\"warn|error\" [$__auto]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "logs",
      "title": "Recent backend errors",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{job=\"docker\"} | json | level=~\"warn|error\"", "refId": "A"}],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLines": false, "prettifyLogMessage": true, "enableLogDetails": true}
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["trainbet", "errors"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "ChooChoo Delay Race errors",
  "uid": "trainbet-errors",
  "version": 1
}
